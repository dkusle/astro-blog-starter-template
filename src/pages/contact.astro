---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead
			title="Contact | Chronically Us"
			description="Contact the Chronically Us community."
		/>
	</head>

	<body>
		<Header />

		<main>
			<h1>Contact</h1>

			<p>
				Thank you for visiting Chronically Us.
			</p>

			<p>
				If you would like to share your story, suggest a community
				prompt, provide feedback, or simply say hello, we'd love to hear
				from you.
			</p>

			<div class="contact-card">
				<h2>Get in Touch</h2>

				<p>
					Email:
					hello@chronicallyus.com
						hello@chronicallyus.com
					</a>
				</p>

				<p>
					Story submissions, community feedback, collaboration ideas,
					and words of encouragement are always welcome.
				</p>
			</div>

			<section>
				<h2>Community Values</h2>

				<ul>
					<li>Kindness and empathy</li>
					<li>Respectful conversations</li>
					<li>Sharing experiences without judgment</li>
					<li>Supporting one another through challenges and victories</li>
				</ul>
			</section>
		</main>

		<Footer />
	</body>
</html>

<style>
	main {
		max-width: 900px;
		margin: 0 auto;
		padding: 2rem;
	}

	.contact-card {
		margin: 2rem 0;
		padding: 2rem;
		background: #f8f8fc;
		border-radius: 12px;
	}

	a {
		color: #6c63ff;
		font-weight: 600;
	}
</style>
