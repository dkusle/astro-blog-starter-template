---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>

	<body>
		<Header />

		<main>
			<section class="hero">
				<h1>Chronically Us</h1>

				<p class="tagline">
					Stories, Strength, and Support for Life with Chronic Illness.
				</p>

				<p class="intro">
					Living with a chronic illness can feel isolating, but no one should
					have to navigate that journey alone. Chronically Us is a community
					built on shared experiences, honest conversations, and mutual support.
				</p>

				<div class="buttons">
					<a href="/blog">Read Stories</a>
					<a href="/prompts">Community Prompts</a>
				</div>
			</section>

			<section>
				<h2>Welcome</h2>

				<p>
					Whether you're living with a chronic illness, supporting a loved
					one, searching for answers, or simply looking for people who
					understand, you're welcome here.
				</p>

				<p>
					This is a place to share experiences, celebrate victories, learn
					from one another, and remember that no one has to face their
					journey alone.
				</p>
			</section>

			<section>
				<h2>What You'll Find Here</h2>

				<div class="feature-grid">
					<div class="feature-card">
						<h3>&#x1F4D6; Personal Stories</h3>
						<p>
							Real experiences from people navigating life with chronic
							illnesses.
						</p>
					</div>

					<div class="feature-card">
						<h3>&#x1F4A1; Community Prompts</h3>
						<p>
							Questions that inspire meaningful conversations and shared
							reflection.
						</p>
					</div>

					<div class="feature-card">
						<h3>&#x1F91D; Community Support</h3>
						<p>
							A welcoming environment built on empathy, understanding,
							and encouragement.
						</p>
					</div>

					<div class="feature-card">
						<h3>&#x1F331; Small Victories</h3>
						<p>
							Celebrating resilience, personal growth, and everyday wins.
						</p>
					</div>
				</div>
			</section>

			<section class="prompt">
				<h2>Community Prompt of the Week</h2>

				<blockquote>
					"What is one thing you wish people understood about living with a
					chronic illness?"
				</blockquote>

				<p>
					We all have unique experiences, and every perspective adds value
					to the conversation.
				</p>
			</section>

			<section>
				<h2>Our Mission</h2>

				<p>
					Chronically Us exists to create a safe, supportive place where
					people can share their stories, find connection, and feel heard.
				</p>

				<p>
					Through storytelling, discussion prompts, and community support,
					we hope to build a space where compassion comes first and every
					person knows their experience matters.
				</p>

				<p class="mission-statement">
					<strong>Every story matters. Every voice deserves to be heard.</strong>
				</p>
			</section>
		</main>

		<Footer />
	</body>
</html>

<style>
	main {
		max-width: 1000px;
		margin: 0 auto;
		padding: 2rem;
	}

	.hero {
		text-align: center;
		padding: 3rem 0;
	}

	.hero h1 {
		font-size: 3.5rem;
		color: #6c63ff;
		margin-bottom: 0.5rem;
	}

	.tagline {
		font-size: 1.4rem;
		font-weight: 600;
		color: #555;
		margin-bottom: 1.5rem;
	}

	.intro {
		max-width: 750px;
		margin: 0 auto;
		font-size: 1.1rem;
		line-height: 1.8;
	}

	.buttons {
		display: flex;
		justify-content: center;
		gap: 1rem;
		margin-top: 2rem;
		flex-wrap: wrap;
	}

	.buttons a {
		background: #6c63ff;
		color: white;
		text-decoration: none;
		padding: 0.85rem 1.5rem;
		border-radius: 8px;
		font-weight: 600;
	}

	.buttons a:hover {
		background: #5b54d6;
	}

	section {
		margin: 4rem 0;
	}

	h2 {
		margin-bottom: 1rem;
		color: #333;
	}

	.feature-grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
		gap: 1.5rem;
		margin-top: 2rem;
	}

	.feature-card {
		padding: 1.5rem;
		border: 1px solid #e5e5ef;
		border-radius: 12px;
		background: #fafafe;
	}

	.prompt {
		padding: 2rem;
		background: #f8f8fc;
		border-radius: 12px;
	}

	blockquote {
		font-size: 1.4rem;
		font-style: italic;
		color: #6c63ff;
		margin: 1rem 0;
	}

	.mission-statement {
		margin-top: 2rem;
		font-size: 1.15rem;
		text-align: center;
	}

	
		.feature-card h3 {
			font-size: 1.1rem;
			margin: 0 0 0.5rem 0;
		}

@media (max-width: 768px) {
		.hero h1 {
			font-size: 2.5rem;
		}

		.tagline {
			font-size: 1.1rem;
		}
	}
</style>



