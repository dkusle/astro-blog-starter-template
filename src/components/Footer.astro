---
const today = new Date();
---

<footer>
	<div class="footer-content">
		<h3>Chronically Us</h3>

		<p class="tagline">
			Stories, Strength, and Support for Life with Chronic Illness.
		</p>

		<p class="mission">
			A welcoming space for sharing experiences, finding connection,
			and reminding one another that no one has to face chronic illness alone.
		</p>

		<div class="footer-links">
			/Home</a>
			/blogStories</a>
			/promptsCommunity Prompts</a>
			/aboutAbout</a>
			/contactContact</a>
		</div>

		<p class="copyright">
			© {today.getFullYear()} Chronically Us
		</p>

		<p class="quote">
			Every story matters. Every voice deserves to be heard.
		</p>
	</div>
</footer>

<style>
	footer {
		margin-top: 4rem;
		padding: 4rem 1.5rem;
		background: #f8f8fc;
		border-top: 1px solid #e7e7f2;
		text-align: center;
	}

	.footer-content {
		max-width: 900px;
		margin: 0 auto;
	}

	h3 {
		color: #6c63ff;
		margin-bottom: 0.5rem;
		font-size: 1.75rem;
	}

	.tagline {
		font-size: 1.05rem;
		font-weight: 600;
		color: #444;
		margin-bottom: 1rem;
	}

	.mission {
		color: #666;
		max-width: 650px;
		margin: 0 auto 2rem auto;
		line-height: 1.7;
	}

	.footer-links {
		display: flex;
		justify-content: center;
		flex-wrap: wrap;
		gap: 1.5rem;
		margin-bottom: 2rem;
	}

	.footer-links a {
		text-decoration: none;
		color: #6c63ff;
		font-weight: 600;
	}

	.footer-links a:hover {
		text-decoration: underline;
	}

	.copyright {
		color: #777;
		margin-bottom: 0.5rem;
	}

	.quote {
		font-style: italic;
		color: #888;
	}
</style>
